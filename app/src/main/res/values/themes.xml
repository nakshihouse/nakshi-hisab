<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework theme (no AppCompat dependency needed).
         windowBackground doubles as the launch splash: brand green
         with the white ledger mark centered. -->
    <style name="Theme.NakshiHisab" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/green_dark</item>
        <item name="android:navigationBarColor">@color/green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
