<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback launcher icon for API 24/25 (adaptive icons need API 26+).
     The foreground vector already carries the brand-green background,
     so this renders as a full green rounded-square ledger icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/green" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="72dp"
        android:height="72dp" />
</layer-list>
